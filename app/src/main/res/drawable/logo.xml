<!-- Uygulama içinde gösterilen logo (simgenin tamamı: koyu yuvarlak kare + H + oynat) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#18203A" android:endColor="#0C1020" />
            <stroke android:width="1dp" android:color="#14FFFFFF" />
        </shape>
    </item>
    <!-- simgedeki güvenli alan boşluğu uygulama içinde gerekmez: işareti büyüt -->
    <item android:drawable="@drawable/ic_foreground" android:left="-12dp" android:top="-12dp" android:right="-12dp" android:bottom="-12dp" />
</layer-list>
