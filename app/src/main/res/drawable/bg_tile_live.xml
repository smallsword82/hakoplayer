<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><gradient android:angle="315" android:startColor="#2F6BFF" android:endColor="#00B4D8" />
            <corners android:radius="20dp" /><stroke android:width="4dp" android:color="#FFFFFF" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><gradient android:angle="315" android:startColor="#2F6BFF" android:endColor="#00B4D8" />
            <corners android:radius="20dp" /><stroke android:width="4dp" android:color="#CCFFFFFF" /></shape>
    </item>
    <item><shape><gradient android:angle="315" android:startColor="#2F6BFF" android:endColor="#00B4D8" />
        <corners android:radius="20dp" /></shape></item>
</selector>
