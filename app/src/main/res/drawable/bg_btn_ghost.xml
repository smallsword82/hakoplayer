<?xml version="1.0" encoding="utf-8"?>
<!-- İkincil pencere düğmesi (Vazgeç vb.): kumandayla üzerine gelince belirgin çerçeve -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="@color/panel2" /><corners android:radius="10dp" />
            <stroke android:width="3dp" android:color="@color/accent" /></shape>
    </item>
    <item><shape><solid android:color="@android:color/transparent" /><corners android:radius="10dp" />
        <stroke android:width="1dp" android:color="@color/line" /></shape></item>
</selector>
