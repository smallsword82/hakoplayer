<?xml version="1.0" encoding="utf-8"?>
<!-- Uygulama pencereleri (çıkış, PIN, seçimler): koyu panel, yuvarlak köşe, ince çerçeve -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="20dp" android:insetRight="20dp" android:insetTop="20dp" android:insetBottom="20dp">
    <shape>
        <solid android:color="@color/panel" />
        <corners android:radius="16dp" />
        <stroke android:width="1dp" android:color="@color/line" />
    </shape>
</inset>
