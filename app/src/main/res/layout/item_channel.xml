<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_item"
    android:focusable="true" android:clickable="true" android:padding="8dp" android:layout_margin="2dp">
    <TextView android:id="@+id/num" android:layout_width="40dp" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="13sp" />
    <ImageView android:id="@+id/logo" android:layout_width="64dp" android:layout_height="40dp"
        android:scaleType="fitCenter" android:background="#22000000" />
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginLeft="12dp" android:singleLine="true"
        android:ellipsize="end" android:textSize="16sp" />
    <TextView android:id="@+id/star" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="★" android:textColor="#FFCC4D" android:visibility="gone" />
</LinearLayout>
