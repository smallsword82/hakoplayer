<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <!-- Üst sekmeler + arama -->
    <LinearLayout android:id="@+id/nav" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/panel"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <TextView android:id="@+id/navBack" style="@style/TopTab" android:text="⌂" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navLive" style="@style/TopTab" android:text="Canlı TV" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navMovie" style="@style/TopTab" android:text="Filmler" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navSeries" style="@style/TopTab" android:text="Diziler" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navFav" style="@style/TopTab" android:text="Favoriler" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navRecent" style="@style/TopTab" android:text="Son İzlenen" />
        <View style="@style/TabDivider" />
        <TextView android:id="@+id/navGuide" style="@style/TopTab" android:text="Rehber" />
        <EditText android:id="@+id/etSearch" style="@style/Field" android:layout_width="0dp" android:layout_weight="1"
            android:layout_marginTop="0dp" android:layout_marginLeft="16dp" android:hint="🔍  Ara"
            android:imeOptions="actionSearch" />
        <TextView android:id="@+id/navSort" style="@style/TopTab" android:layout_marginLeft="4dp" android:text="⇅ Sırala"
            android:paddingLeft="8dp" android:paddingRight="6dp" android:visibility="gone" />
        <TextView android:id="@+id/navReload" style="@style/TopTab" android:layout_marginLeft="0dp" android:text="⟳"
            android:paddingLeft="6dp" android:paddingRight="8dp" />
        <TextView android:id="@+id/tvAccount" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:maxWidth="220dp" android:maxLines="3" android:ellipsize="end"
            android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Kategoriler -->
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCategories"
            android:layout_width="0dp" android:layout_weight="0.58" android:layout_height="match_parent"
            android:padding="8dp" android:clipToPadding="false" android:background="@color/panel" />

        <!-- Kanallar / afişler -->
        <LinearLayout android:layout_width="0dp" android:layout_weight="0.92" android:layout_height="match_parent"
            android:orientation="vertical" android:paddingLeft="3dp" android:paddingRight="8dp" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/tvTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="16sp" android:textStyle="bold"
                android:textColor="@color/muted" android:singleLine="true" android:paddingLeft="6dp" />
            <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
            <TextView android:id="@+id/tvEmpty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:textColor="@color/muted" android:visibility="gone" android:padding="24dp" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvItems"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:layout_marginTop="6dp" android:clipToPadding="false" />
        </LinearLayout>

        <!-- Canlı TV önizleme -->
        <LinearLayout android:id="@+id/previewPanel" android:layout_width="0dp" android:layout_weight="1.6"
            android:layout_height="match_parent" android:orientation="vertical" android:background="@color/panel"
            android:visibility="gone">
            <FrameLayout android:id="@+id/previewBox" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:background="#000000">
                <androidx.media3.ui.PlayerView android:id="@+id/previewView"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:focusable="false" app:use_controller="false" app:show_buffering="always" />
                <TextView android:id="@+id/tvPreviewMsg" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center"
                    android:padding="16dp" android:textColor="@color/muted"
                    android:text="Önizlemek için bir kanal seçin\nTekrar OK: tam ekran" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="14dp" android:paddingRight="14dp" android:paddingTop="10dp" android:paddingBottom="6dp">
                <ImageView android:id="@+id/ivPreviewLogo" android:layout_width="64dp" android:layout_height="40dp"
                    android:scaleType="fitCenter" android:visibility="gone" />
                <TextView android:id="@+id/tvPreviewName" android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:textSize="22sp"
                    android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/tvPreviewEpg" android:layout_width="match_parent" android:layout_height="0dp"
                android:layout_weight="1" android:paddingLeft="14dp" android:paddingRight="14dp"
                android:textColor="@color/muted" android:textSize="14sp" android:lineSpacingExtra="2dp" />
            <LinearLayout android:id="@+id/previewButtons" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="end"
                android:padding="12dp" android:visibility="gone">
                <Button android:id="@+id/btnPreviewFav" style="@style/Btn" android:text="☆ Favorilere ekle" />
                <Button android:id="@+id/btnFullscreen" style="@style/Btn" android:layout_marginLeft="10dp"
                    android:text="⛶ Tam ekran" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
