<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:id="@+id/row" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:id="@+id/formPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="24dp" android:background="@drawable/bg_panel">

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/logo"
                    android:layout_marginRight="14dp" android:contentDescription="@null" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="HakoPlayer" android:textSize="30sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:layout_marginTop="4dp"
                android:text="Kendi IPTV aboneliğinizi ekleyin. Uygulama içerik sağlamaz, yalnızca oynatıcıdır." />

            <!-- Üçüncü taraf açık liste (iptv-org). Hiç liste yokken en üstte; varken kayıtlı listelerin altında -->
            <LinearLayout android:id="@+id/freeBox" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginTop="18dp" android:padding="16dp"
                android:background="@drawable/bg_free">
                <TextView android:id="@+id/tvFreeHint" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/text" android:textSize="15sp"
                    android:text="Aboneliğiniz yok mu? Herkese açık ulusal kanalları tek tuşla açın." />
                <Button android:id="@+id/btnFreeTr" style="@style/Btn" android:layout_width="match_parent"
                    android:layout_marginTop="10dp" android:textSize="17sp"
                    android:text="📺 Ücretsiz Türk kanalları ekle" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="12sp"
                    android:text="Kaynak: iptv-org (üçüncü taraf açık liste)" />
            </LinearLayout>

            <TextView android:id="@+id/savedTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Kayıtlı listeler" android:textStyle="bold" android:layout_marginTop="18dp" />
            <LinearLayout android:id="@+id/savedList" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Yeni liste ekle" android:textStyle="bold" android:layout_marginTop="18dp" />
            <RadioGroup android:id="@+id/typeGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/rbXtream" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Xtream Codes" android:checked="true"
                    android:background="@drawable/bg_item" android:padding="8dp" />
                <RadioButton android:id="@+id/rbM3u" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="M3U URL"
                    android:background="@drawable/bg_item" android:padding="8dp" android:layout_marginLeft="8dp" />
            </RadioGroup>

            <EditText android:id="@+id/etName" style="@style/Field" android:hint="Liste adı (ör. Ev)" />
            <EditText android:id="@+id/etServer" style="@style/Field" android:inputType="textUri"
                android:hint="Sunucu (http://ornek.com:8080)" />
            <EditText android:id="@+id/etUser" style="@style/Field" android:hint="Kullanıcı adı" />
            <EditText android:id="@+id/etPass" style="@style/Field" android:hint="Şifre"
                android:inputType="textPassword" />
            <EditText android:id="@+id/etUrl" style="@style/Field" android:inputType="textUri"
                android:hint="http://.../get.php?username=..&amp;type=m3u_plus" android:visibility="gone" />

            <Button android:id="@+id/btnAdd" style="@style/Btn" android:layout_width="match_parent"
                android:layout_marginTop="14dp" android:text="Ekle ve Bağlan" />
            <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
            <TextView android:id="@+id/tvError" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="#FF5C7A" android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/qrPanel" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp"
            android:background="@drawable/bg_panel" android:layout_marginTop="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📱 Telefonla ekle" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:gravity="center" android:layout_marginTop="6dp"
                android:text="QR kodu telefonunuzun kamerasıyla okutun, bilgileri telefondan girin." />
            <ImageView android:id="@+id/ivQr" android:layout_width="230dp" android:layout_height="230dp"
                android:layout_marginTop="14dp" android:background="#FFFFFF" android:padding="6dp" />
            <TextView android:id="@+id/tvServerUrl" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textSize="18sp" android:textStyle="bold" android:textIsSelectable="false" />
            <TextView android:id="@+id/tvCode" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/accent" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/muted" android:textSize="12sp" android:gravity="center" android:layout_marginTop="6dp"
                android:text="Telefon ve cihaz aynı Wi-Fi / ağda olmalı" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
