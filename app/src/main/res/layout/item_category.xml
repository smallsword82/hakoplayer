<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/bg_item"
    android:focusable="true" android:clickable="true" android:paddingLeft="12dp" android:paddingRight="12dp" android:paddingTop="7dp" android:paddingBottom="7dp" android:layout_margin="1dp">
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textSize="15sp" />
    <TextView android:id="@+id/count" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/muted" android:textSize="13sp" android:layout_marginLeft="6dp" />
</LinearLayout>
